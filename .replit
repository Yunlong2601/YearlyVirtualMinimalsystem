run = ["gunicorn", "--bind", "0.0.0.0:5000", "a1:app"]
entrypoint = "a1.py"
modules = ["python-3.11"]
hidden = [".pythonlibs"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["gunicorn", "--bind", "0.0.0.0:5000", "a1:app"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 81
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[auth]
pageEnabled = true
buttonEnabled = false
